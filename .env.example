# Copy to backend/.env. Read by docker-compose.yml.

# Bagisto admin login (http://localhost:8000/admin). Use a long random password.
ADMIN_EMAIL=admin@zuno.local
ADMIN_PASSWORD=

# Required: encrypts sessions and checkout tokens. Generate once and keep it:
#   node -e "console.log('base64:' + require('crypto').randomBytes(32).toString('base64'))"
APP_KEY=

# Razorpay keys (Dashboard > Account & Settings > API Keys). Leave empty for pay on delivery.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# "Continue with Google". In Google Cloud Console: APIs & Services > Credentials > Create OAuth client ID
# (Web application). Authorized redirect URI: <shop address>/api/zuno/account/google/callback
#   locally: http://localhost:5173/api/zuno/account/google/callback
# Leave empty to hide the button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
